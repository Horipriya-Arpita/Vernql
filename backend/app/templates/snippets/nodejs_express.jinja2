/**
 * Vernql API Integration — Node.js / Express
 * Complete integration including session management, SQL execution,
 * and the result feedback loop that drives widget visualizations.
 *
 * Install: npm install express axios
 */
const express = require('express');
const axios   = require('axios');

const app = express();
app.use(express.json());

// ── Configuration ─────────────────────────────────────────────────────────────
const VERNQL_API_KEY  = '{{ api_key }}';
const VERNQL_BASE_URL = '{{ base_url }}';
const SCHEMA_ID       = '{{ schema_id }}';

const vernqlHeaders = {
  'X-API-Key': VERNQL_API_KEY,
  'Content-Type': 'application/json',
};


// ── Step 1 · Session ──────────────────────────────────────────────────────────

/**
 * Create a new conversational session.
 * Returns a session_id that groups queries so the AI keeps context
 * across follow-up questions and pushes results to the widget via SSE.
 * Store this ID (e.g. in Redis or your DB) and reuse it per user.
 */
async function vernqlCreateSession() {
  const resp = await axios.post(
    `${VERNQL_BASE_URL}/{{ api_version }}/sessions`,
    { schema_id: SCHEMA_ID },
    { headers: vernqlHeaders, timeout: 10000 }
  );
  return resp.data.session_id;
}


// ── Step 2 · SQL Generation ───────────────────────────────────────────────────

/**
 * Convert a natural language question to SQL.
 * Pass sessionId to maintain multi-turn context across questions.
 * Returns: { id, generated_sql, confidence_score, warnings, ... }
 */
async function vernqlGenerateSQL(question, sessionId = null) {
  const payload = { schema_id: SCHEMA_ID, query: question };
  if (sessionId) payload.session_id = sessionId;

  const resp = await axios.post(
    `${VERNQL_BASE_URL}/{{ api_version }}/queries`,
    payload,
    { headers: vernqlHeaders, timeout: 30000 }
  );
  return resp.data;
}


