// ── Step 4 · Submit results for visualization ─────────────────────────────────

/**
 * Send query results back to Vernql.
 * Vernql auto-detects the best chart type (bar, line, pie, metric, table),
 * generates an AI insight, and — when sessionId is present — pushes the
 * visualization to any widget connected to that session via SSE.
 * Returns: { chart_type, ai_insight, visualization_data, ... }
 */
async function vernqlSubmitResults(queryId, rows, sessionId = null) {
  const payload = {
    query_id: queryId,
    results: rows,
    generate_insight: true,
  };
  if (sessionId) payload.session_id = sessionId;

  const resp = await axios.post(
    `${VERNQL_BASE_URL}/{{ api_version }}/visualizations/display`,
    payload,
    { headers: vernqlHeaders, timeout: 30000 }
  );
  return resp.data;
}


// ── Route ─────────────────────────────────────────────────────────────────────

/**
 * POST /query — Full Vernql integration: NL → SQL → execute → visualize.
 *
 * Body:
 *   question   string   required  Natural language question
 *   session_id string   optional  Reuse for follow-up questions
 *
 * Response:
 *   session_id         Use for the next question in the same conversation
 *   sql                Generated SELECT statement
 *   query_id           Needed if you want to submit results manually
 *   chart_type         bar | line | pie | metric | table
 *   ai_insight         One-sentence AI summary of the results
 *   visualization_data Chart-ready data structure
 *
 * First question:
 *   POST /query  { "question": "{{ query_example }}" }
 *
 * Follow-up:
 *   POST /query  { "question": "Now filter to last 30 days", "session_id": "<from above>" }
 */
app.post('/query', async (req, res) => {
  const { question, session_id: incomingSessionId } = req.body;

  if (!question) {
    return res.status(400).json({ error: "Missing 'question'" });
  }

  let sessionId = incomingSessionId || null;

  // Create a session on the first turn if the caller didn't supply one
  if (!sessionId) {
    try {
      sessionId = await vernqlCreateSession();
    } catch (err) {
      console.warn('[Vernql] Could not create session:', err.message);
      // widget still works without SSE; continue without session
    }
  }

  try {
    // Step 2 — Generate SQL
    const queryResult = await vernqlGenerateSQL(question, sessionId);
    const { generated_sql: sql, id: queryId } = queryResult;

    // Step 3 — Run the SQL on YOUR database
    const rows = await runOnYourDatabase(sql);

    // Step 4 — Submit results; Vernql visualizes and pushes to widget via SSE
    const viz = await vernqlSubmitResults(queryId, rows, sessionId);

    res.json({
      success:            true,
      session_id:         sessionId,
      sql,
      query_id:           queryId,
      chart_type:         viz.chart_type,
      ai_insight:         viz.ai_insight,
      visualization_data: viz.visualization_data,
    });

  } catch (err) {
    const status = err.message.startsWith('Connect') ? 501
                 : err.response                      ? 502
                 :                                     500;
    console.error('[Vernql] Query failed:', err.message);
    res.status(status).json({ error: err.message });
  }
});

app.get('/health', (_req, res) => res.json({ status: 'healthy' }));

// Error-handling middleware
app.use((err, _req, res, _next) => {
  console.error('[Vernql] Unhandled error:', err);
  res.status(500).json({ error: 'Internal server error' });
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log('Vernql Express Integration');
  console.log('-'.repeat(40));
  console.log(`Server: http://localhost:${PORT}`);
  console.log('POST /query — NL → SQL → run → visualize');
});

module.exports = app;