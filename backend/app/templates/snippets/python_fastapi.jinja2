"""
Vernql API Integration — FastAPI
Complete integration including session management, SQL execution,
and the result feedback loop that drives widget visualizations.
"""
import httpx
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field
from typing import Any, Dict, List, Optional

app = FastAPI(title="Vernql Integration API")

# ── Configuration ─────────────────────────────────────────────────────────────
VERNQL_API_KEY  = "{{ api_key }}"
VERNQL_BASE_URL = "{{ base_url }}"
SCHEMA_ID       = "{{ schema_id }}"

_HEADERS = {
    "X-API-Key": VERNQL_API_KEY,
    "Content-Type": "application/json",
}


# ── Request / Response models ─────────────────────────────────────────────────

class QueryRequest(BaseModel):
    question:   str            = Field(..., description="Natural language question")
    session_id: Optional[str]  = Field(None, description="Reuse for follow-up questions")


class QueryResponse(BaseModel):
    success:            bool
    session_id:         Optional[str]       = None
    sql:                Optional[str]       = None
    query_id:           Optional[str]       = None
    chart_type:         Optional[str]       = None
    ai_insight:         Optional[str]       = None
    visualization_data: Optional[Any]       = None
    error:              Optional[str]       = None


# ── Step 1 · Session ──────────────────────────────────────────────────────────

async def vernql_create_session() -> str:
    """
    Create a new conversational session.
    Returns a session_id that groups queries so the AI keeps context
    across follow-up questions and pushes results to the widget via SSE.
    Store this ID (e.g. in a database or Redis) and reuse it per user.
    """
    async with httpx.AsyncClient(timeout=10) as client:
        resp = await client.post(
            f"{VERNQL_BASE_URL}/{{ api_version }}/sessions",
            json={"schema_id": SCHEMA_ID},
            headers=_HEADERS,
        )
        resp.raise_for_status()
        return resp.json()["session_id"]


# ── Step 2 · SQL Generation ───────────────────────────────────────────────────

async def vernql_generate_sql(question: str, session_id: Optional[str] = None) -> dict:
    """
    Convert a natural language question to SQL.
    Pass session_id to maintain multi-turn context across questions.
    Returns dict with keys: id (query_id), generated_sql, confidence_score, warnings.
    """
    payload: Dict[str, Any] = {"schema_id": SCHEMA_ID, "query": question}
    if session_id:
        payload["session_id"] = session_id

    async with httpx.AsyncClient(timeout=30) as client:
        resp = await client.post(
            f"{VERNQL_BASE_URL}/{{ api_version }}/queries",
            json=payload,
            headers=_HEADERS,
        )
        if resp.status_code >= 400:
            raise HTTPException(status_code=502, detail=f"Vernql API error: {resp.text}")
        return resp.json()


