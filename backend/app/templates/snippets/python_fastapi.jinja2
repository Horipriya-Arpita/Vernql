    raise NotImplementedError("Connect run_on_your_database() to your real database.")


# ── Step 4 · Submit results for visualization ─────────────────────────────────

async def vernql_submit_results(
    query_id: str,
    rows: List[Dict[str, Any]],
    session_id: Optional[str] = None,
) -> dict:
    """
    Send query results back to Vernql.
    Vernql auto-detects the best chart type (bar, line, pie, metric, table),
    generates an AI insight, and — when session_id is present — pushes the
    visualization to any widget connected to that session via SSE.
    Returns dict with keys: chart_type, ai_insight, visualization_data.
    """
    payload: Dict[str, Any] = {
        "query_id": query_id,
        "results": rows,
        "generate_insight": True,
    }
    if session_id:
        payload["session_id"] = session_id

    async with httpx.AsyncClient(timeout=30) as client:
        resp = await client.post(
            f"{VERNQL_BASE_URL}/{{ api_version }}/visualizations/display",
            json=payload,
            headers=_HEADERS,
        )
        if resp.status_code >= 400:
            raise HTTPException(status_code=502, detail=f"Vernql API error: {resp.text}")
        return resp.json()


# ── Route ─────────────────────────────────────────────────────────────────────

@app.post("/query", response_model=QueryResponse)
async def query_endpoint(body: QueryRequest):
    """
    Full Vernql integration — NL → SQL → execute → visualize.

    Pass session_id from a previous response to continue the same conversation.
    On the first question, omit it and save the returned session_id for follow-ups.

    Example first question:
        POST /query
        { "question": "{{ query_example }}" }

    Example follow-up:
        POST /query
        { "question": "Now filter to last 30 days", "session_id": "<from above>" }
    """
    session_id = body.session_id

    # Create a session on the first turn if the caller didn't supply one
    if not session_id:
        try:
            session_id = await vernql_create_session()
        except Exception:
            pass  # widget still works without SSE; continue without session

    try:
        # Step 2 — Generate SQL
        query_result = await vernql_generate_sql(body.question, session_id)
        sql      = query_result["generated_sql"]
        query_id = query_result["id"]

        # Step 3 — Run the SQL on YOUR database
        rows = await run_on_your_database(sql)

        # Step 4 — Submit results; Vernql visualizes and pushes to widget via SSE
        viz = await vernql_submit_results(query_id, rows, session_id)

        return QueryResponse(
            success=True,
            session_id=session_id,
            sql=sql,
            query_id=query_id,
            chart_type=viz.get("chart_type"),
            ai_insight=viz.get("ai_insight"),
            visualization_data=viz.get("visualization_data"),
        )

    except NotImplementedError as exc:
        raise HTTPException(status_code=501, detail=str(exc))
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))


