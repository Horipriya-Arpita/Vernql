// ── Step 4 · Submit results for visualization ─────────────────────────────────

/**
 * Send query results back to Vernql.
 * Vernql auto-detects the best chart type (bar, line, pie, metric, table),
 * generates an AI insight, and — when session_id is present — pushes the
 * visualization to any widget connected to that session via SSE.
 * Returns array with keys: chart_type, ai_insight, visualization_data.
 */
function vernql_submit_results(string $queryId, array $rows, ?string $sessionId = null): array {
    $payload = [
        'query_id'         => $queryId,
        'results'          => $rows,
        'generate_insight' => true,
    ];
    if ($sessionId) {
        $payload['session_id'] = $sessionId;
    }
    return vernql_post('/{{ api_version }}/visualizations/display', $payload);
}


// ── Request handler ───────────────────────────────────────────────────────────

/**
 * Full Vernql integration — NL → SQL → execute → visualize.
 *
 * POST /query.php
 * Content-Type: application/json
 * {
 *   "question":   "{{ query_example }}",
 *   "session_id": "<optional — reuse for follow-up questions>"
 * }
 *
 * Response:
 * {
 *   "session_id":         "...",   // save and send back for follow-ups
 *   "sql":                "SELECT ...",
 *   "chart_type":         "bar",
 *   "ai_insight":         "...",
 *   "visualization_data": { ... }
 * }
 */
function handle_query_request(): void {
    header('Content-Type: application/json');

    if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
        http_response_code(405);
        echo json_encode(['error' => 'Use POST']);
        return;
    }

    $input = file_get_contents('php://input');
    $data  = json_decode($input, true);

    if (json_last_error() !== JSON_ERROR_NONE || empty($data['question'])) {
        http_response_code(400);
        echo json_encode(['error' => "Missing 'question'"]);
        return;
    }

    $question  = trim($data['question']);
    $sessionId = $data['session_id'] ?? null;

    // Create a session on the first turn if the caller didn't supply one
    if (!$sessionId) {
        try {
            $sessionId = vernql_create_session();
        } catch (Exception $e) {
            error_log('[Vernql] Could not create session: ' . $e->getMessage());
            // widget still works without SSE; continue without session
        }
    }

    try {
        // Step 2 — Generate SQL
        $queryResult = vernql_generate_sql($question, $sessionId);
        $sql         = $queryResult['generated_sql'];
        $queryId     = $queryResult['id'];

        // Step 3 — Run the SQL on YOUR database
        $rows = run_on_your_database($sql);

        // Step 4 — Submit results; Vernql visualizes and pushes to widget via SSE
        $viz = vernql_submit_results($queryId, $rows, $sessionId);

        echo json_encode([
            'success'            => true,
            'session_id'         => $sessionId,
            'sql'                => $sql,
            'query_id'           => $queryId,
            'chart_type'         => $viz['chart_type']         ?? null,
            'ai_insight'         => $viz['ai_insight']         ?? null,
            'visualization_data' => $viz['visualization_data'] ?? null,
        ]);

    } catch (RuntimeException $e) {
        $code = str_starts_with($e->getMessage(), 'Connect') ? 501 : 502;
        http_response_code($code);
        echo json_encode(['error' => $e->getMessage()]);
    } catch (Exception $e) {
        http_response_code(500);
        echo json_encode(['error' => $e->getMessage()]);
    }
}

// ── Router ────────────────────────────────────────────────────────────────────

$path = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);

switch (rtrim($path, '/')) {
    case '/query':
    case '/query.php':
        handle_query_request();
        break;

    case '/health':
    case '/health.php':
        header('Content-Type: application/json');
        echo json_encode(['status' => 'healthy']);
        break;

    default:
        header('Content-Type: application/json');
        echo json_encode([
            'service'   => 'Vernql Integration API',
            'endpoints' => ['POST /query', 'GET /health'],
        ]);
}
