<?php
/**
 * Vernql API Integration — PHP
 * Complete integration including session management, SQL execution,
 * and the result feedback loop that drives widget visualizations.
 *
 * Requires: PHP curl extension (php-curl)
 */

// ── Configuration ─────────────────────────────────────────────────────────────
define('VERNQL_API_KEY',  '{{ api_key }}');
define('VERNQL_BASE_URL', '{{ base_url }}');
define('SCHEMA_ID',       '{{ schema_id }}');


// ── HTTP helper ───────────────────────────────────────────────────────────────

/**
 * Make a JSON POST request to the Vernql API.
 * Returns decoded response array on success, throws on HTTP error.
 */
function vernql_post(string $path, array $payload): array {
    $url  = VERNQL_BASE_URL . $path;
    $body = json_encode($payload);

    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $body,
        CURLOPT_HTTPHEADER     => [
            'X-API-Key: '    . VERNQL_API_KEY,
            'Content-Type: application/json',
            'Content-Length: ' . strlen($body),
        ],
        CURLOPT_TIMEOUT        => 30,
    ]);

    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $error    = curl_error($ch);
    curl_close($ch);

    if ($error) {
        throw new RuntimeException("cURL error: $error");
    }
    if ($httpCode >= 400) {
        throw new RuntimeException("Vernql API error HTTP $httpCode: $response");
    }

    return json_decode($response, true);
}


// ── Step 1 · Session ──────────────────────────────────────────────────────────

/**
 * Create a new conversational session.
 * Returns a session_id that groups queries so the AI keeps context
 * across follow-up questions and pushes results to the widget via SSE.
 * Store this ID (e.g. in $_SESSION or your database) per user.
 */
function vernql_create_session(): string {
    $data = vernql_post('/{{ api_version }}/sessions', ['schema_id' => SCHEMA_ID]);
    return $data['session_id'];
}


// ── Step 2 · SQL Generation ───────────────────────────────────────────────────

/**
 * Convert a natural language question to SQL.
 * Pass $sessionId to maintain multi-turn context across questions.
 * Returns array with keys: id, generated_sql, confidence_score, warnings.
 */
function vernql_generate_sql(string $question, ?string $sessionId = null): array {
    $payload = ['schema_id' => SCHEMA_ID, 'query' => $question];
    if ($sessionId) {
        $payload['session_id'] = $sessionId;
    }
    return vernql_post('/{{ api_version }}/queries', $payload);
}


