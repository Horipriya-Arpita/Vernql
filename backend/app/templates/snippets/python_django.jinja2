import json
import requests
from django.conf import settings
from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt
from django.views.decorators.http import require_http_methods

# ── Configuration ─────────────────────────────────────────────────────────────
# Add these to your settings.py, or set them directly here.
VERNQL_API_KEY  = getattr(settings, "VERNQL_API_KEY",  "{{ api_key }}")
VERNQL_BASE_URL = getattr(settings, "VERNQL_BASE_URL", "{{ base_url }}")
SCHEMA_ID       = getattr(settings, "VERNQL_SCHEMA_ID", "{{ schema_id }}")

_HEADERS = {
    "X-API-Key": VERNQL_API_KEY,
    "Content-Type": "application/json",
}


# ── Step 1 · Session ──────────────────────────────────────────────────────────

def vernql_create_session():
    """
    Create a new conversational session.
    Returns a session_id that groups queries so the AI keeps context
    across follow-up questions and pushes results to the widget via SSE.
    Store this ID (e.g. in Django session or your database) per user.
    """
    resp = requests.post(
        f"{VERNQL_BASE_URL}/{{ api_version }}/sessions",
        json={"schema_id": SCHEMA_ID},
        headers=_HEADERS,
        timeout=10,
    )
    resp.raise_for_status()
    return resp.json()["session_id"]


# ── Step 2 · SQL Generation ───────────────────────────────────────────────────

def vernql_generate_sql(question, session_id=None):
    """
    Convert a natural language question to SQL.
    Pass session_id to maintain multi-turn context across questions.
    Returns dict with keys: id (query_id), generated_sql, confidence_score, warnings.
    """
    payload = {"schema_id": SCHEMA_ID, "query": question}
    if session_id:
        payload["session_id"] = session_id

    resp = requests.post(
        f"{VERNQL_BASE_URL}/{{ api_version }}/queries",
        json=payload,
        headers=_HEADERS,
        timeout=30,
    )
    resp.raise_for_status()
    return resp.json()


