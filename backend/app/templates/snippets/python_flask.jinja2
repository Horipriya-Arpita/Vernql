# ── Step 4 · Submit results for visualization ─────────────────────────────────

def vernql_submit_results(query_id, rows, session_id=None):
    """
    Send query results back to Vernql.
    Vernql auto-detects the best chart type (bar, line, pie, metric, table),
    generates an AI insight, and — when session_id is present — pushes the
    visualization to any widget connected to that session via SSE.
    Returns dict with keys: chart_type, ai_insight, visualization_data.
    """
    payload = {
        "query_id": query_id,
        "results": rows,
        "generate_insight": True,
    }
    if session_id:
        payload["session_id"] = session_id

    resp = requests.post(
        f"{VERNQL_BASE_URL}/{{ api_version }}/visualizations/display",
        json=payload,
        headers=_HEADERS,
        timeout=30,
    )
    resp.raise_for_status()
    return resp.json()


# ── Route ─────────────────────────────────────────────────────────────────────

@app.route("/query", methods=["POST"])
def query_endpoint():
    """
    Full Vernql integration — NL → SQL → execute → visualize.

    Request body (JSON):
        question   string   required  Natural language question
        session_id string   optional  Reuse an existing session for follow-ups

    Response (JSON):
        session_id        string  Use this for the next question in the same conversation
        sql               string  Generated SELECT statement
        query_id          string  Needed when submitting results manually
        chart_type        string  bar | line | pie | metric | table
        ai_insight        string  One-sentence AI summary of the results
        visualization_data object Chart-ready data structure

    Example request:
        POST /query
        { "question": "{{ query_example }}" }

    Example follow-up:
        POST /query
        { "question": "Now filter to last 30 days", "session_id": "<from above>" }
    """
    data = request.get_json()
    if not data or not data.get("question"):
        return jsonify({"error": "Missing 'question'"}), 400

    question   = data["question"]
    session_id = data.get("session_id")

    # Create a session on the first turn if the caller didn't supply one
    if not session_id:
        try:
            session_id = vernql_create_session()
        except Exception as exc:
            app.logger.warning("Could not create Vernql session: %s", exc)

    try:
        # Step 2 — Generate SQL
        query_result = vernql_generate_sql(question, session_id)
        sql      = query_result["generated_sql"]
        query_id = query_result["id"]

        # Step 3 — Run the SQL on YOUR database
        rows = run_on_your_database(sql)

        # Step 4 — Submit results; Vernql visualizes and pushes to widget via SSE
        viz = vernql_submit_results(query_id, rows, session_id)

        return jsonify({
            "success":            True,
            "session_id":         session_id,
            "sql":                sql,
            "query_id":           query_id,
            "chart_type":         viz.get("chart_type"),
            "ai_insight":         viz.get("ai_insight"),
            "visualization_data": viz.get("visualization_data"),
        })

    except NotImplementedError as exc:
        return jsonify({"error": str(exc)}), 501
    except requests.exceptions.HTTPError as exc:
        return jsonify({"error": f"Vernql API error: {exc}"}), 502
    except Exception as exc:
        app.logger.error("Query failed: %s", exc)
        return jsonify({"error": "Internal server error"}), 500


@app.route("/health")
def health():
    return jsonify({"status": "healthy"})


