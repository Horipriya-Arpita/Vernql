"""
Vernql API Integration — Flask
Complete integration including session management, SQL execution,
and the result feedback loop that drives widget visualizations.
"""
import requests
from flask import Flask, request, jsonify

app = Flask(__name__)

# ── Configuration ─────────────────────────────────────────────────────────────
VERNQL_API_KEY  = "{{ api_key }}"
VERNQL_BASE_URL = "{{ base_url }}"
SCHEMA_ID       = "{{ schema_id }}"

_HEADERS = {
    "X-API-Key": VERNQL_API_KEY,
    "Content-Type": "application/json",
}


# ── Step 1 · Session ──────────────────────────────────────────────────────────

def vernql_create_session():
    """
    Create a new conversational session.
    Returns a session_id that groups queries so the AI keeps context
    across follow-up questions and pushes results to the widget via SSE.
    Store this ID (e.g. in Flask session / Redis) and reuse it per user.
    """
    resp = requests.post(
        f"{VERNQL_BASE_URL}/{{ api_version }}/sessions",
        json={"schema_id": SCHEMA_ID},
        headers=_HEADERS,
        timeout=10,
    )
    resp.raise_for_status()
    return resp.json()["session_id"]


# ── Step 2 · SQL Generation ───────────────────────────────────────────────────

def vernql_generate_sql(question, session_id=None):
    """
    Convert a natural language question to SQL.
    Pass session_id to maintain multi-turn context across questions.
    Returns dict with keys: id (query_id), generated_sql, confidence_score, warnings.
    """
    payload = {"schema_id": SCHEMA_ID, "query": question}
    if session_id:
        payload["session_id"] = session_id

    resp = requests.post(
        f"{VERNQL_BASE_URL}/{{ api_version }}/queries",
        json=payload,
        headers=_HEADERS,
        timeout=30,
    )
    resp.raise_for_status()
    return resp.json()


