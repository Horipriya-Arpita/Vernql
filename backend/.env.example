# Application Configuration
APP_NAME=TextSQL API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# API Configuration
API_V1_PREFIX=/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database Configuration
DATABASE_URL=postgresql://textsql:textsql@localhost:5432/textsql
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
API_KEY_PREFIX=textsql_
API_KEY_LENGTH=32

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# AI Configuration
# Primary: OpenAI (required)
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o

# Optional: Anthropic (fallback)
ANTHROPIC_API_KEY=
AI_TIMEOUT=30
AI_MAX_RETRIES=3

# SQL Generation Settings
SQL_CONFIDENCE_THRESHOLD=0.70
SQL_MAX_EXAMPLES=5
SQL_DEFAULT_LIMIT=1000

# Schema Settings
SCHEMA_MAX_SIZE_MB=10
SCHEMA_ENRICHMENT_BATCH_SIZE=20

# Result Size Limits (prevents memory exhaustion from oversized payloads)
RESULT_MAX_ROWS=10000
RESULT_MAX_SIZE_MB=50.0

# Query Settings
QUERY_HISTORY_RETENTION_DAYS=90
QUERY_MAX_EXECUTION_TIME_MS=30000

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=
